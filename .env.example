# ==============================================================================
# Raasta (रास्ता) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. SARVAM AI (Optional — for Indic Voice AI, Speech-to-Text & Text-to-Speech)
# ------------------------------------------------------------------------------
# Get your API key at: https://sarvam.ai
# If not provided, fallback mock explanations and browser voice are used.
SARVAM_API_KEY=

# ------------------------------------------------------------------------------
# 2. PERSISTENCE / DATABASE (Optional — PostgreSQL via Supabase / Neon / Local)
# ------------------------------------------------------------------------------
# If not provided, Raasta runs smoothly in in-memory mode with deterministic hydration.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/raasta
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. ENVIRONMENT & PORT
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
